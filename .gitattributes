# Normalize line endings: store LF in the repository, regardless of the OS.
* text=auto eol=lf

# Text files that should never be treated as binary.
*.md    text
*.yml   text
*.yaml  text
*.svg   text
*.json  text

# Genuinely binary assets.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
